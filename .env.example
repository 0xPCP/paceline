# Required
DB_PASSWORD=changeme
SECRET_KEY=change-this-to-a-long-random-string
# Set false only for local plain-HTTP development.
COOKIE_SECURE=true

# Optional hosted Stripe Payment Link. Defaults to the Paceline donation page.
DONATE_URL=https://buy.stripe.com/dRm7sFgkK2yb8VwgrZ9AA00

# Optional Stripe Connect automation for club dues. These are platform-level
# secrets from the Paceline Stripe account; leave blank to use manual dues only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Future running-club support. Leave false until the multi-sport UI is ready.
MULTISPORT_UI_ENABLED=false

# Google OAuth sign-in / registration. Configure these in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Email provider. Use Resend for production transactional email.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_MAX_ATTEMPTS=3
RESEND_RETRY_BACKOFF_SECONDS=2,5,15
MAIL_DEFAULT_SENDER=Paceline <noreply@paceline.club>
# Optional safety override for development/testing. Resend provides safe test
# addresses like delivered@resend.dev, bounced@resend.dev, and complained@resend.dev.
EMAIL_RECIPIENT_OVERRIDE=

# Strava integration (optional — club feed and member linking)
# Create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# The Strava club ID (found in your club URL on Strava)
STRAVA_CLUB_ID=
# A refresh token from a club member (admin) used to power the public club feed
# Obtain by running the OAuth flow with scope=read,activity:read
STRAVA_CLUB_REFRESH_TOKEN=

# DigitalOcean Spaces — object storage for ride photos (production only).
# Leave these blank for local / TrueNAS dev (files stored on disk instead).
# Create a Spaces bucket + access key at cloud.digitalocean.com/spaces.
SPACES_BUCKET=
SPACES_REGION=nyc3
# Endpoint format: https://<region>.digitaloceanspaces.com
SPACES_ENDPOINT=
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
# Optional CDN edge URL for the Spaces bucket (e.g. https://cdn.example.com).
# When set, public-club photos are served directly from the CDN (no pre-signed URL).
# Leave blank to always use pre-signed URLs (safe default).
SPACES_PUBLIC_BASE_URL=

# App Platform injects PORT automatically; set it here only for local testing.
# PORT=8000
